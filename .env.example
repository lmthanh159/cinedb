# App
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://cinedb:cinedb_dev_password@localhost:55432/cinedb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Recommendation
RECOMMENDATION_URL=http://localhost:5000
RECOMMENDATION_TIMEOUT_MS=3000

# JWT
JWT_ACCESS_SECRET=cinedb-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=cinedb-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# TMDB
TMDB_API_KEY=your-tmdb-api-key-here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_RATE_LIMIT=4
TMDB_DEFAULT_LANGUAGE=vi-VN
TMDB_FALLBACK_LANGUAGE=en-US

# Storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cinedb.local
